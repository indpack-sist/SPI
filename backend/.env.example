# ==========================================================================
# backend/.env.example  —  PLANTILLA SIN VALORES REALES
# Copiar a backend/.env para desarrollo local. NUNCA subir el .env real a Git.
# En producción estas variables viven en Render (Dashboard -> Environment).
# ==========================================================================

# --- Base de datos (MySQL / Railway) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- App ---
PORT=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
TZ=America/Lima

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================================
# SUNAT — Facturación electrónica nativa (SEE Del Contribuyente)
# ==========================================================================
# BETA para pruebas (usuario MODDATOS / clave moddatos). PROD solo en Fase 16.
SUNAT_MODE=BETA

# Emisor (ficha RUC de INDPACK)
SUNAT_RUC=
SUNAT_RAZON_SOCIAL=
SUNAT_NOMBRE_COMERCIAL=
SUNAT_UBIGEO=
SUNAT_DIRECCION=
SUNAT_DISTRITO=
SUNAT_PROVINCIA=
SUNAT_DEPARTAMENTO=

# Usuario secundario SOL (real: SPIFAC01). En BETA usar MODDATOS / moddatos.
SUNAT_SOL_USER=
SUNAT_SOL_PASS=

# Certificado y clave privada en base64 de una sola línea (base64 -w0 de los .pem)
SUNAT_CERT_B64=
SUNAT_KEY_B64=

# Credenciales API GRE (OAuth2) — Guías de Remisión
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=
